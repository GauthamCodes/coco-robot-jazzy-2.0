<?xml version="1.0"?>
<robot name="coco" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    ═══════════════════════════════════════════════════════════════════════
    Coco robot — Jazzy + Gazebo Harmonic model (Layer 1 rebuild)

    The CAD export used a Y-up frame; previously the robot was spawned
    tipped over with roll=+90 deg to compensate, which broke REP-103
    (odom/TF semantics) and everything downstream (SLAM, Nav2, MoveIt).

    This model re-roots the robot on a proper z-up base_link. All CAD-frame
    link contents (meshes, inertials, joint origins) are preserved exactly
    and mounted under a single fixed re-rooting joint base_link->chassis_link
    (xyz 0.12 -0.08 0, rpy +90deg roll), which the SDF converter lumps away.

    Wheel layout in base_link frame (x forward, y left, z up):
      wheel1 = front-right   wheel2 = rear-right   (joints base_Revolute-1/-2)
      wheel3 = front-left    wheel4 = rear-left    (joints base_Revolute-3/-4)
    Wheels 1/2 use axis 0 0 -1 (instead of flipping the link frame) so that
    positive joint velocity drives the robot forward on BOTH sides — the
    mixed CAD joint orientations are normalised here, not in plugin config.
    ═══════════════════════════════════════════════════════════════════════
  -->

  <xacro:property name="mesh_pkg"     value="package://gazebo_models/meshes"/>
  <xacro:property name="mesh_scale"   value="0.001 0.001 0.001"/>
  <xacro:property name="wheel_radius" value="0.0585"/>
  <xacro:property name="wheel_width"  value="0.04"/>
  <!-- CAD auto-density gave 3.74 kg per wheel (94% of robot mass), which
       dominated the dynamics and caused massive wheel slip. 0.4 kg is a
       realistic printed wheel; inertia = solid cylinder of that mass. -->
  <xacro:property name="wheel_mass"   value="0.4"/>
  <xacro:property name="arm_effort"   value="10.0"/>
  <xacro:property name="arm_velocity" value="2.0"/>

  <material name="coco_dark_grey"><color rgba="0.25 0.25 0.25 1"/></material>
  <material name="coco_black"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="coco_orange"><color rgba="0.9 0.45 0.1 1"/></material>
  <material name="coco_light_grey"><color rgba="0.7 0.7 0.7 1"/></material>

  <!-- ════════════════════════ BASE ════════════════════════ -->

  <link name="base_footprint"/>

  <!-- base_link sits at axle height; wheels contact ground 0.0135 m below -->
  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0.0135" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link"/>

  <!-- Re-rooting joint: maps the CAD frame (Y-up) onto the z-up base_link.
       Derivation: new = (x_cad + 0.12, -z_cad - 0.08, y_cad), i.e. the four
       wheel joints land at (±0.09, ±0.137, 0.045). -->
  <joint name="chassis_joint" type="fixed">
    <origin xyz="0.12 -0.08 0" rpy="1.5707963267948966 0 0"/>
    <parent link="base_link"/>
    <child link="chassis_link"/>
  </joint>

  <link name="chassis_link">
    <inertial>
      <origin xyz="-0.11999999999999998 0.03034175823095615 -0.08" rpy="0 0 0"/>
      <mass value="1.041325435922023"/>
      <inertia ixx="0.0037170473661447996" iyy="0.008245766799475876" izz="0.005624963316002818"
               ixy="8.673617379884035e-19" iyz="8.673617379884035e-19" ixz="-6.938893903907228e-18"/>
    </inertial>
    <visual name="chassis_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_pkg}/base.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="coco_dark_grey"/>
    </visual>
    <!-- Primitive collision (mesh bbox): big RTF win over STL collision -->
    <collision name="chassis_collision">
      <origin xyz="-0.12 0.03 -0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.06 0.274"/>
      </geometry>
    </collision>
  </link>

  <!-- ════════════════════════ WHEELS ════════════════════════
       Link frames and contents are the original CAD export; only the
       collision geometry is replaced by a cylinder along the spin axis (z).
  -->
  <xacro:macro name="wheel_link" params="name mesh">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 -0.0138190943" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <!-- solid cylinder: izz = mr^2/2, ixx = iyy = m(3r^2 + w^2)/12 -->
        <inertia ixx="3.95e-04" iyy="3.95e-04" izz="6.85e-04"
                 ixy="0" iyz="0" ixz="0"/>
      </inertial>
      <visual name="${name}_visual">
        <origin xyz="2.387e-06 0.008117301100053282 0.01616833941417112" rpy="1.5707963267679181 0 0"/>
        <geometry>
          <mesh filename="${mesh_pkg}/${mesh}" scale="${mesh_scale}"/>
        </geometry>
        <material name="coco_black"/>
      </visual>
      <collision name="${name}_collision">
        <origin xyz="0 0 -0.0155" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:wheel_link name="wheel1" mesh="wheel1.stl"/>
  <xacro:wheel_link name="wheel2" mesh="wheel2.stl"/>
  <xacro:wheel_link name="wheel3" mesh="wheel3.stl"/>
  <xacro:wheel_link name="wheel4" mesh="wheel4.stl"/>

  <!-- Right side (wheels 1,2): CAD frame upright, axis flipped to 0 0 -1 so
       +velocity = forward. Left side (wheels 3,4): CAD frame rolled pi,
       axis 0 0 1 already gives +velocity = forward. -->
  <!-- Wheel effort ceiling. These joints were `continuous` with NO <limit>, and
       the ros2_control interface below caps only velocity (+/-15 rad/s), so the
       velocity servo had UNBOUNDED torque authority. Measured consequence: PPO's
       modulated velocity commands produced repeated torque spikes whose reaction
       reared the chassis nose-up to -35 deg WITHOUT the robot translating (x
       stayed at ~0.00), tipping 93-98% of training episodes. A constant command
       settles to a small velocity error and is fine, which is why scripted
       climbs always worked and only training failed.
       Sizing: a steady 24 deg climb needs 0.181 N.m per wheel and accelerating
       at the controller's 2.0 m/s^2 limit needs 0.087, so 0.4 leaves ~1.5x
       margin over the worst legitimate demand while staying well under the
       ~0.67 N.m per wheel required to rear the chassis. -->
  <joint name="base_Revolute-1" type="continuous">
    <origin xyz="-0.03 0.045 0.057" rpy="0 0 0"/>
    <parent link="chassis_link"/>
    <child link="wheel1"/>
    <axis xyz="0 0 -1"/>
    <dynamics damping="0.01" friction="0.05"/>
    <limit effort="0.4" velocity="15.0"/>
  </joint>
  <joint name="base_Revolute-2" type="continuous">
    <origin xyz="-0.21 0.045 0.057" rpy="0 0 0"/>
    <parent link="chassis_link"/>
    <child link="wheel2"/>
    <axis xyz="0 0 -1"/>
    <dynamics damping="0.01" friction="0.05"/>
    <limit effort="0.4" velocity="15.0"/>
  </joint>
  <joint name="base_Revolute-3" type="continuous">
    <origin xyz="-0.03 0.045 -0.217" rpy="3.141592653589793 0 0"/>
    <parent link="chassis_link"/>
    <child link="wheel3"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.05"/>
    <limit effort="0.4" velocity="15.0"/>
  </joint>
  <joint name="base_Revolute-4" type="continuous">
    <origin xyz="-0.21 0.045 -0.217" rpy="3.141592653589793 0 0"/>
    <parent link="chassis_link"/>
    <child link="wheel4"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.05"/>
    <limit effort="0.4" velocity="15.0"/>
  </joint>

  <!-- ════════════════════════ ARM ════════════════════════
       3-DOF arm + 2-finger gripper. Joints are revolute with real limits
       (the old model used continuous joints whose <limit> tags were
       silently ignored) and damping so the arm cannot free-swing during
       the controller activation window.
  -->

  <link name="m_link1">
    <inertial>
      <origin xyz="-0.03854063080383259 -0.0015856480020825358 0.04275065515243506" rpy="0 0 0"/>
      <mass value="0.10501532872977405"/>
      <inertia ixx="0.00010224213087689287" iyy="0.00021767174405659022" izz="0.00013090575214547108"
               ixy="-3.3343062572426755e-06" iyz="3.011180028965072e-06" ixz="9.638287881954372e-05"/>
    </inertial>
    <visual name="m_link1_visual">
      <origin xyz="-0.018369053406696097 0.002499999962747097 0.029475549941264376" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_pkg}/m_link1.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="coco_light_grey"/>
    </visual>
    <!-- Primitive collisions (mesh bbox) on all arm links: gz-physics DART
         silently loads NO collision for STL meshes here, so the mesh
         collisions meant the arm had no physical presence at all. -->
    <collision name="m_link1_collision">
      <origin xyz="-0.0345 0.0 0.0495" rpy="0 0 0"/>
      <geometry>
        <box size="0.129 0.060 0.099"/>
      </geometry>
    </collision>
  </link>

  <link name="m_link2">
    <inertial>
      <origin xyz="0.06604665739982733 -0.00550001164803783 -0.0009375331400820297" rpy="0 0 0"/>
      <mass value="0.07714503259769957"/>
      <inertia ixx="9.355290836035222e-06" iyy="0.00027097957152510477" izz="0.0002633781068698384"
               ixy="-7.937952985967445e-07" iyz="2.2876686443025918e-08" ixz="2.1753091556992897e-06"/>
    </inertial>
    <visual name="m_link2_visual">
      <origin xyz="0.09980773579424788 -0.010000000111758691 -0.025756860748654162" rpy="0 0.007575854115264767 0"/>
      <geometry>
        <mesh filename="${mesh_pkg}/m_link2.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="coco_orange"/>
    </visual>
    <!-- Three fitted boxes instead of one mesh bounding box: the link is a
         slim beam (|z| < ~0.019 m) with 50 mm motor blocks only at the two
         ends (measured from m_link2.stl vertex extents). The old single
         0.050 m-tall box made the whole forearm as thick as its motors and
         cost several degrees of reach before "colliding" with the chassis. -->
    <collision name="m_link2_collision_shoulder_block">
      <origin xyz="-0.005 -0.0075 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.040 0.015 0.050"/>
      </geometry>
    </collision>
    <collision name="m_link2_collision_beam">
      <origin xyz="0.0775 -0.0075 -0.0015" rpy="0 0 0"/>
      <geometry>
        <box size="0.125 0.015 0.038"/>
      </geometry>
    </collision>
    <collision name="m_link2_collision_elbow_block">
      <origin xyz="0.155 -0.0075 -0.0012" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.015 0.042"/>
      </geometry>
    </collision>
  </link>

  <link name="m_link3">
    <inertial>
      <origin xyz="0.011018238497968848 0.009999999888241292 -1.9935736369163238e-05" rpy="0 0 0"/>
      <mass value="0.024128837009105796"/>
      <inertia ixx="1.8845190178237389e-06" iyy="7.548306330095421e-06" izz="7.269906777337368e-06"
               ixy="1.3559074268166147e-20" iyz="5.6005324621510986e-39" ixz="9.746960985909268e-09"/>
    </inertial>
    <visual name="m_link3_visual">
      <origin xyz="-4.49683090764097e-09 -1.1175870895385742e-10 2.7528110546626294e-09" rpy="-3.141592653589793 -0.0018119992531012543 3.141592653589793"/>
      <geometry>
        <mesh filename="${mesh_pkg}/m_link3.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="coco_light_grey"/>
    </visual>
    <collision name="m_link3_collision">
      <origin xyz="0.0169 0.01 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.064 0.020 0.030"/>
      </geometry>
    </collision>
  </link>

  <link name="grip1">
    <inertial>
      <origin xyz="0.022687836333347696 0.004041120571939869 0.006491176980784364" rpy="0 0 0"/>
      <mass value="0.0019453742039578018"/>
      <inertia ixx="4.348735470033379e-08" iyy="6.250592176565233e-07" izz="5.974629046405576e-07"
               ixy="-1.0538123946724974e-09" iyz="-2.2111795926127908e-10" ixz="-1.2202969558862574e-07"/>
    </inertial>
    <visual name="grip1_visual">
      <origin xyz="-1.3593625099403983e-05 0.0074999912986458295 -1.1175870895385742e-10" rpy="-3.141592653589793 9.832692144899154e-09 0.001811999253101829"/>
      <geometry>
        <mesh filename="${mesh_pkg}/grip1.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="coco_black"/>
    </visual>
    <collision name="grip1_collision">
      <origin xyz="0.0249 0.004 0.0048" rpy="0 0 0"/>
      <geometry>
        <box size="0.059 0.007 0.0185"/>
      </geometry>
    </collision>
    <!-- End-stop lip at the pad tip, protruding 5 mm inward (-z): the flat
         pads alone let a grasped cylinder slide along the pad length and
         escape during lift; the lips form a partial cage. High enough
         above the pedestal top that grasp descent still collision-checks
         clean against the pedestal. -->
    <collision name="grip1_lip">
      <origin xyz="0.0514 0.004 -0.00695" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.007 0.005"/>
      </geometry>
    </collision>
  </link>

  <link name="grip2">
    <inertial>
      <origin xyz="0.02057296729304557 0.004037288426624359 -0.01156102460324302" rpy="0 0 0"/>
      <mass value="0.0019453742039578018"/>
      <inertia ixx="1.2796522234849025e-07" iyy="6.250594950268097e-07" izz="5.129847596221384e-07"
               ixy="-9.007383940598359e-10" iyz="4.2322370849995914e-10" ixz="2.335670086952937e-07"/>
    </inertial>
    <visual name="grip2_visual">
      <origin xyz="-9.096372686928644e-07 0.0005000027903372128 -1.1175870895385742e-10" rpy="6.964882040425079e-18 0.23324311682993576 0.001811999253101171"/>
      <geometry>
        <mesh filename="${mesh_pkg}/grip2.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="coco_black"/>
    </visual>
    <collision name="grip2_collision">
      <origin xyz="0.0231 0.004 -0.0104" rpy="0 0.2332 0"/>
      <geometry>
        <box size="0.059 0.007 0.0185"/>
      </geometry>
    </collision>
    <!-- Mirror of grip1_lip (+z is inward for this finger); origin is the
         pad-frame tip offset rotated by the pad's 0.2332 rad pitch. -->
    <collision name="grip2_lip">
      <origin xyz="0.0516 0.004 -0.00509" rpy="0 0.2332 0"/>
      <geometry>
        <box size="0.006 0.007 0.005"/>
      </geometry>
    </collision>
  </link>

  <!-- Arm mount. The CAD export attached the bracket to the chassis BOTTOM
       face (y=0 in CAD coords, +90deg roll), which put the whole arm BELOW
       the wheels — the robot literally stood on its elbow (this was the
       hidden cause of the original "low RTF" and "arm oscillation" issues).
       Remounted on the TOP face (y=0.06) with mirrored roll: shoulder pivot
       lands at z=0.135, q=0 is a safe horizontal home, negative shoulder
       raises the arm, small positive shoulder reaches down to the floor in
       front of the robot (pick-and-place workspace). -->
  <joint name="base_Rigid-5" type="fixed">
    <origin xyz="-0.12 0.06 -0.08" rpy="-1.5707963267948966 0 0"/>
    <parent link="chassis_link"/>
    <child link="m_link1"/>
  </joint>

  <joint name="m_link1_Revolute-6" type="revolute">
    <origin xyz="-0.075 0.0075 0.075" rpy="3.141592653589793 0 0"/>
    <parent link="m_link1"/>
    <child link="m_link2"/>
    <axis xyz="0 -1 0"/>
    <limit effort="${arm_effort}" velocity="${arm_velocity}" lower="-3.84" upper="1.0"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <joint name="m_link2_Revolute-7" type="revolute">
    <origin xyz="0.1499957 0.0 -0.0011363699999999977" rpy="0 0 0"/>
    <parent link="m_link2"/>
    <child link="m_link3"/>
    <axis xyz="0 1 0"/>
    <limit effort="${arm_effort}" velocity="${arm_velocity}" lower="-1.6" upper="1.6"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <joint name="m_link3_Revolute-8" type="revolute">
    <origin xyz="0.040901179999999995 0.015 0.0039258999999999935" rpy="-1.5707963267948966 0 0"/>
    <parent link="m_link3"/>
    <child link="grip1"/>
    <axis xyz="0.001812 -0.999998 0"/>
    <limit effort="${arm_effort}" velocity="${arm_velocity}" lower="-0.35" upper="1.1"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <joint name="m_link3_Revolute-9" type="revolute">
    <origin xyz="0.040901179999999995 0.005 0.0039258999999999935" rpy="-1.5707963267948966 0 0"/>
    <parent link="m_link3"/>
    <child link="grip2"/>
    <axis xyz="0.001812 -0.999998 0"/>
    <limit effort="${arm_effort}" velocity="${arm_velocity}" lower="-1.1" upper="0.35"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- ════════════════════════ SENSORS (Layer 2) ════════════════════════
       2D lidar on a small front mast + RGBD camera on the front face.
       The lidar scans a 240-degree front arc: a full 360 would see the
       robot's own arm whenever it is raised (the arm works at the rear).
  -->

  <!-- Rear-corner tall mast: keeps the lidar and its scan plane clear of
       the arm's workspace. A front mast at z=0.12 sat exactly where the
       gripper passes at home, and a rear-center mast clipped m_link2's
       tail — both caught by MoveIt state-validity checks. The arm moves in
       the y=0 plane, so the mast lives at y=0.10 (rear-left corner). -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="2e-05" iyy="2e-05" izz="2e-05" ixy="0" iyz="0" ixz="0"/>
    </inertial>
    <visual name="lidar_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
      <material name="coco_black"/>
    </visual>
    <visual name="lidar_mast_visual">
      <origin xyz="0 0 -0.08" rpy="0 0 0"/>
      <geometry><cylinder radius="0.012" length="0.12"/></geometry>
      <material name="coco_dark_grey"/>
    </visual>
    <collision name="lidar_collision">
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.18"/></geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="-0.09 0.10 0.20" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="1e-05" iyy="1e-05" izz="1e-05" ixy="0" iyz="0" ixz="0"/>
    </inertial>
    <visual name="camera_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.015 0.06 0.02"/></geometry>
      <material name="coco_dark_grey"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.125 0 0.055" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <!-- Standard REP-103 optical frame (z forward, x right) for point clouds -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
  </joint>

  <!-- IMU at the body centre: attitude feedback for ramp traversal (RL) -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-06" iyy="1e-06" izz="1e-06" ixy="0" iyz="0" ixz="0"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>480</samples>
            <resolution>1</resolution>
            <min_angle>-2.0944</min_angle>
            <max_angle>2.0944</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camera" type="rgbd_camera">
      <topic>camera</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.25</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.05</near><far>8.0</far></clip>
        <depth_camera><clip><near>0.1</near><far>8.0</far></clip></depth_camera>
      </camera>
    </sensor>
  </gazebo>

  <!-- ════════════════════════ ROS2_CONTROL ════════════════════════
       Velocity interfaces for all four wheels (DiffDriveController),
       position interfaces for the arm (JointTrajectoryController) and
       gripper (2-joint JointTrajectoryController).
  -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <xacro:macro name="wheel_iface" params="joint">
      <joint name="${joint}">
        <command_interface name="velocity">
          <param name="min">-15.0</param>
          <param name="max">15.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:wheel_iface joint="base_Revolute-1"/>
    <xacro:wheel_iface joint="base_Revolute-2"/>
    <xacro:wheel_iface joint="base_Revolute-3"/>
    <xacro:wheel_iface joint="base_Revolute-4"/>

    <xacro:macro name="arm_iface" params="joint">
      <joint name="${joint}">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:arm_iface joint="m_link1_Revolute-6"/>
    <xacro:arm_iface joint="m_link2_Revolute-7"/>
    <xacro:arm_iface joint="m_link3_Revolute-8"/>
    <xacro:arm_iface joint="m_link3_Revolute-9"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find gazebo_models)/urdf/coco_controllers.yaml</parameters>
    </plugin>
    <!-- Ground-truth world pose (bridged to /model/coco/odometry): used by
         the RL env for reward shaping — wheel odometry under-reads on the
         ramp slope. Publishes no ROS TF, so it cannot fight the diff-drive
         controller's odom->base_footprint transform. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/model/coco/odometry</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

  <!-- ── Magnet grasp ──────────────────────────────────────────────────────
       One DetachableJoint per graspable model: a command on the attach
       topic welds that model to the gripper palm at whatever relative pose
       it currently holds, and the detach topic releases it.

       This replaces friction pinching, which was measured not to
       generalise. The arm is 2-DOF with no wrist, so the pinch point is
       fixed relative to the forearm and the clearance between the open
       fingers and a 28 mm cylinder is 5.88-7.76 mm over a 70 mm descent.
       Tightening the MoveIt joint tolerance from 0.02 to 0.003 rad (see
       pick_place.py) bought back ~5.5 mm of that budget and moved the
       docs/RESULTS.md points from 0/4 to 2/4: real, but still a coin
       flip. Welding on contact makes the grasp a decision instead of a
       tolerance stack-up, which is what lets the fetch mission pick any of
       four objects at four positions rather than one tuned point.

       parent_link is m_link3, the palm, not grip1/grip2: the object should
       stay rigid with respect to the forearm while the fingers keep
       moving. suppress_child_warning because these models are spawned at
       runtime and do not exist when the robot loads. -->
  <xacro:macro name="magnet" params="model link:=link">
    <gazebo>
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
        <parent_link>m_link3</parent_link>
        <child_model>${model}</child_model>
        <child_link>${link}</child_link>
        <attach_topic>/magnet/${model}/attach</attach_topic>
        <detach_topic>/magnet/${model}/detach</detach_topic>
        <output_topic>/magnet/${model}/state</output_topic>
        <suppress_child_warning>true</suppress_child_warning>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- The pick-and-place demo's cylinder. The mission's four coloured
       objects get one line each here once M5 names them. -->
  <xacro:magnet model="pick_target"/>
  <!-- The fetch mission's four platform targets
       (full_world_robo.launch.py, traverse:=true). Each binds
       independently, so the mission picks one and leaves three. -->
  <xacro:magnet model="target_red"/>
  <xacro:magnet model="target_green"/>
  <xacro:magnet model="target_blue"/>
  <xacro:magnet model="target_yellow"/>

  <!-- Moderate isotropic wheel friction: enough longitudinal traction to
       drive and climb the ramp, low enough that the 4-wheel skid-steer
       base can break lateral grip and yaw. (Anisotropic mu1/mu2 without an
       explicit fdir1 is direction-lottery in DART — do not use it here.)
       Skid-steer yaw loss is compensated by wheel_separation_multiplier
       in coco_controllers.yaml. -->
  <xacro:macro name="wheel_friction" params="name">
    <gazebo reference="${name}">
      <mu1>0.7</mu1>
      <mu2>0.7</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_friction name="wheel1"/>
  <xacro:wheel_friction name="wheel2"/>
  <xacro:wheel_friction name="wheel3"/>
  <xacro:wheel_friction name="wheel4"/>

  <!-- High-friction finger pads so a pinched object does not slide out
       vertically during the lift -->
  <gazebo reference="grip1">
    <mu1>2.5</mu1>
    <mu2>2.5</mu2>
  </gazebo>
  <gazebo reference="grip2">
    <mu1>2.5</mu1>
    <mu2>2.5</mu2>
  </gazebo>

</robot>
