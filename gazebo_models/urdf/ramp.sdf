<?xml version="1.0"?>
<!-- Static ramp model for Gazebo Harmonic. The mesh is a clean parametric
     wedge generated by scripts/gen_ramp.py (already in metres, so no scale) —
     it replaces the shipped rampcoco.stl, an unclimbable CAD shell with a
     ~66 deg near-vertical face (see docs/DESIGN_DECISIONS.md).
     The mesh filename encodes the grade (ramp_wedge_<deg>.stl); the launch
     file swaps in the curriculum angle and rewrites the package:// URI to an
     absolute file:// path before spawning. -->
<sdf version="1.8">
  <model name="ramp">
    <static>true</static>
    <link name="ramp_link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>package://gazebo_models/meshes/ramp_wedge_18.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.6 1</ambient>
          <diffuse>0.55 0.55 0.6 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>package://gazebo_models/meshes/ramp_wedge_18.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
