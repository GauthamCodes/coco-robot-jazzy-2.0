<?xml version="1.0"?>
<!-- coco_world — Gazebo Harmonic (gz-sim 8) walled arena.
     Ported from Gazebo Classic: explicit system plugins (sensors system is
     required for the Layer-2 lidar/camera), plain PBR colours instead of
     Classic material scripts, default DART physics. -->
<sdf version="1.8">
  <world name="coco_world">

    <physics name="default_physics" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.8</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <light name="fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <direction>0.5 -0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static><pose>2.0 3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12 0.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12 0.2 1.0</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static><pose>2.0 -3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12 0.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12 0.2 1.0</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static><pose>-4.0 0.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 7.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 7.2 1.0</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static><pose>8.0 0.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 7.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 7.2 1.0</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Obstacles for SLAM/Nav2 demos (Layer 2): boxes between the robot
         spawn (-2,0) and the ramp (3,0) so maps have structure.

         All neutral grey since the fetch mission: the four target objects on
         the ramp platform are picked out of the camera image by hue, and
         these used to be brownish-red (0.6 0.3 0.1) and blue (0.2 0.4 0.7),
         which collide with two of the four target colours in HSV. Making the
         targets the only saturated colours in the arena is worth more than
         any amount of threshold tuning. -->
    <!-- Was at (0.5, 1.2), which predated the fetch mission's lanes and
         then sat on one: it spans y 0.95..1.45, and the pre-ramp pose for
         lane +0.75 is 0.20 m from that face — inside the collision
         monitor's 0.25 m stop polygon. The robot drove there and was
         correctly halted, logging "Failed to make progress" until the leg
         timed out. Moved to the north-west corner, which was the emptiest
         part of the arena and therefore the most useful place to put
         structure for the scan matcher. -->
    <model name="box_obstacle_1">
      <static>true</static><pose>-3.0 2.4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.57 1</ambient><diffuse>0.55 0.55 0.57 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_obstacle_2">
      <static>true</static><pose>0.8 -1.4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.57 1</ambient><diffuse>0.55 0.55 0.57 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Off the dead-centre spawn->ramp line (was -0.8 0.3, which sat right in
         the RL robot's approach and tipped episodes at the messy old ramp edge).
         Now at y=+0.6 it forces a modest steer-around on the approach without
         blocking it, and is still structure for the SLAM/Nav2 maps. -->
    <model name="cylinder_obstacle">
      <static>true</static><pose>-0.2 0.6 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.55 0.55 0.57 1</ambient><diffuse>0.55 0.55 0.57 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Zone A gate (x -3.9..-0.45 was empty). Two 0.5 m cubes leaving a
         1.30 m gap that is deliberately NOT centred on y=0: it spans
         y -0.50..+0.80, so the shortest path around them is visibly
         off-centre. A planner demo where the optimal path is a straight
         line does not show a planner doing anything.

         The RL corridor runs from spawn (-2, 0) straight along y~0 and
         passes through this gate with room to spare. `--randomize` moves
         the spawn +/-0.5 m in y, which can put the robot into the south
         cube — noted here rather than discovered inside a curriculum. -->
    <model name="gate_cube_north">
      <static>true</static><pose>-1.1 1.05 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.57 1</ambient><diffuse>0.55 0.55 0.57 1</diffuse></material></visual>
      </link>
    </model>
    <model name="gate_cube_south">
      <static>true</static><pose>-1.1 -0.75 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.57 1</ambient><diffuse>0.55 0.55 0.57 1</diffuse></material></visual>
      </link>
    </model>

    <!-- East-corridor features. The corridor behind the ramp is two long
         parallel surfaces, which leaves the scan matcher unconstrained
         along the corridor axis — map_drive.py's ROUTE skipped it for
         exactly that reason, and FUTURE_WORK calls it out. The mission's
         return leg has to cross it, so these break the symmetry and make it
         mappable. Environment design, not a workaround.

         Mounted FLUSH TO THE EAST WALL as 0.3 m pilasters, not free-standing
         boxes. The corridor is only 1.4 m wide (down-ramp foot at x=6.5, the
         east wall's inner face at 7.9), so a 0.6 m box standing in the
         middle of it left the return leg squeezing past with ~0.1 m to
         spare. Against the wall they take 0.3 m and leave 1.1 m clear, while
         still giving the matcher a distinct landmark at a known y — which is
         the whole job. -->
    <model name="feature_pilaster_north">
      <static>true</static><pose>7.72 2.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 0.5 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 0.5 0.6</size></box></geometry>
          <material><ambient>0.55 0.55 0.57 1</ambient><diffuse>0.55 0.55 0.57 1</diffuse></material></visual>
      </link>
    </model>
    <model name="feature_pilaster_south">
      <static>true</static><pose>7.72 -1.4 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 0.5 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 0.5 0.6</size></box></geometry>
          <material><ambient>0.55 0.55 0.57 1</ambient><diffuse>0.55 0.55 0.57 1</diffuse></material></visual>
      </link>
    </model>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.53 0.81 0.92 1</background>
      <shadows>true</shadows>
    </scene>

  </world>
</sdf>
