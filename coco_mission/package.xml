<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>coco_mission</name>
  <version>1.0.0</version>
  <description>
    Launch files that compose the whole Coco fetch mission: Nav2, the
    velocity arbiter, perception, MoveIt, the RL ramp driver, the platform
    approach and the grasp server.

    It exists as its own package because of the dependency graph, not for
    tidiness. The natural home would have been gazebo_models, which owns
    the world and the sequencer script — but coco_moveit_config already
    depends on gazebo_models for the robot description, so a launch file
    in gazebo_models that starts move_group closes a cycle and colcon
    refuses to order the workspace at all. Whatever composes every layer
    has to sit above all of them.

    The SIMULATOR is deliberately not part of this. One Gazebo runs at a
    time on this machine and the mission needs a fresh one per run (the
    DetachableJoint binds each target once, on first spawn), so starting
    it stays a separate, deliberate command.
  </description>
  <maintainer email="gauthamanil888@gmail.com">gautham</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- mission_hud.py, mission_executive.py -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- mission_executive.py: the NavigateToPose client, the Trigger
       clients for every subsystem service, the action goal status, and
       coco_config for the lane table and the ramp geometry. -->
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>coco_config</exec_depend>
  <!-- /imu, the source for ROBOT PITCH. -->
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- nav2_rviz_plugins supplies the ParticleCloud display that
       mission.rviz uses; nav2_msgs/ParticleCloud is not renderable by
       any rviz_default_plugins display. -->
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <!-- rviz_2d_overlay_plugins renders /mission/hud_overlay inside the
       RViz window. Deliberately NOT a dependency: mission_hud detects
       its absence and falls back to the String topic, so the mission
       runs identically without it. Install to get the on-screen HUD:
         sudo apt install ros-jazzy-rviz-2d-overlay-plugins -->

  <test_depend>ament_cmake_pytest</test_depend>

  <!-- Every layer mission.launch.py starts. -->
  <exec_depend>gazebo_models</exec_depend>
  <exec_depend>custom_teleop</exec_depend>
  <exec_depend>coco_perception</exec_depend>
  <exec_depend>coco_moveit_config</exec_depend>
  <exec_depend>coco_rl</exec_depend>
  <!-- The browser control panel. mission.launch.py resolves its
       share directory to include web.launch.py, so a workspace
       without it fails at launch, not at build. -->
  <exec_depend>coco_web</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
