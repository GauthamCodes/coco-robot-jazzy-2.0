<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>coco_sim</name>
  <version>1.0.0</version>
  <description>Generates the MuJoCo (MJCF) model of the Coco base from coco_config, so one set of constants drives both simulators</description>
  <maintainer email="gauthamanil888@gmail.com">gautham</maintainer>
  <license>Apache-2.0</license>

  <depend>coco_config</depend>
  <!-- MuJoCo has no rosdep key, so this is a pip dependency declared in
       setup.py and recorded here for a human reading the manifest.
       Phase 1 measured throughput against a user-site pip install that no
       manifest mentioned, which meant coco_sim would not have built on a
       fresh machine. Pinned to the version the numbers in RESULTS.md were
       produced with: a physics engine version is not a free variable when
       the package's whole purpose is sim-to-sim fidelity. -->
  <!-- pip: mujoco==3.11.0 -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
